/**
 * Zen App Launcher
 * Colour source: ~/.config/zen/zen.sh → ~/.config/rofi/colors/zen.rasi
 **/

configuration {
    modi:                 "drun,run,filebrowser,window";
    show-icons:           true;
    display-drun:         "";
    display-run:          "";
    display-filebrowser:  "";
    display-window:       "";
    drun-display-format:  "{name}";
    window-format:        "{w} · {c} · {t}";
}

@import "~/.config/rofi/colors/zen.rasi"

* {
    font: "0xProto Nerd Font Mono 13";
}

/*****----- Main Window -----*****/
window {
    transparency:      "real";
    location:          center;
    anchor:            center;
    fullscreen:        false;
    width:             680px;
    enabled:           true;
    margin:            0px;
    padding:           0px;
    border:            1px solid;
    border-radius:     12px;
    border-color:      @selected;
    cursor:            "default";
    background-color:  @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:           true;
    spacing:           0px;
    padding:           0px;
    background-color:  transparent;
    orientation:       vertical;
    children:          [ "inputbar", "listbox" ];
}

listbox {
    spacing:           0px;
    padding:           12px;
    background-color:  transparent;
    orientation:       vertical;
    children:          [ "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:           true;
    spacing:           10px;
    padding:           16px 20px;
    border:            0px 0px 1px 0px solid;
    border-radius:     12px 12px 0px 0px;
    border-color:      @selected;
    background-color:  @background-alt;
    text-color:        @foreground;
    orientation:       horizontal;
    children:          [ "textbox-prompt-colon", "entry", "dummy", "mode-switcher" ];
}
textbox-prompt-colon {
    enabled:           true;
    expand:            false;
    str:               "";
    padding:           10px 12px;
    border-radius:     8px;
    background-color:  @background;
    text-color:        @selected;
}
entry {
    enabled:           true;
    expand:            false;
    width:             260px;
    padding:           10px 14px;
    border-radius:     8px;
    background-color:  @background;
    text-color:        @foreground;
    cursor:            text;
    placeholder:       "Search…";
    placeholder-color: #878787;
}
dummy {
    expand:            true;
    background-color:  transparent;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    enabled:           true;
    spacing:           8px;
    background-color:  transparent;
}
button {
    width:             36px;
    padding:           10px;
    border-radius:     8px;
    background-color:  @background;
    text-color:        @foreground;
    cursor:            pointer;
}
button selected {
    background-color:  @selected;
    text-color:        @background;
}

/*****----- Listview -----*****/
listview {
    enabled:           true;
    columns:           1;
    lines:             8;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    layout:            vertical;
    fixed-height:      true;
    spacing:           2px;
    background-color:  transparent;
    cursor:            "default";
}

/*****----- Elements -----*****/
element {
    enabled:           true;
    spacing:           12px;
    padding:           8px 12px;
    border-radius:     8px;
    background-color:  transparent;
    text-color:        @foreground;
    cursor:            pointer;
}
element-icon {
    background-color:  transparent;
    size:              28px;
    cursor:            inherit;
}
element-text {
    background-color:  transparent;
    text-color:        inherit;
    cursor:            inherit;
    vertical-align:    0.5;
    horizontal-align:  0.0;
}
element normal.normal {
    background-color:  transparent;
    text-color:        @foreground;
}
element selected.normal {
    background-color:  @background-alt;
    text-color:        @selected;
}
element normal.urgent {
    background-color:  @urgent;
    text-color:        @background;
}
element selected.urgent {
    background-color:  @urgent;
    text-color:        @background;
}
element normal.active {
    background-color:  @active;
    text-color:        @background;
}
element selected.active {
    background-color:  @active;
    text-color:        @background;
}

/*****----- Message -----*****/
message {
    background-color:  transparent;
}
textbox {
    padding:           10px 14px;
    border-radius:     8px;
    background-color:  @background-alt;
    text-color:        @foreground;
    vertical-align:    0.5;
    horizontal-align:  0.0;
}
error-message {
    padding:           12px;
    border-radius:     8px;
    background-color:  @background;
    text-color:        @foreground;
}
