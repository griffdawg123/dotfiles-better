# Add this line to your existing ~/.zshrc to enable Powerlevel10k support
# You can add it at the end of your current zsh configuration

# === POWERLEVEL10K ADDON ===
# Adds p10k support while preserving your existing configuration
[[ ! -f ~/.config/p10k/p10k-addon.zsh ]] || source ~/.config/p10k/p10k-addon.zsh